        "ra-core": "^5.8.0",
        "ra-ui-materialui": "^5.8.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router": "^6.23.1",
        "typescript": "^5.7.3",
        "zshy": "^0.5.0"
    },
    "peerDependencies": {
        "@mui/icons-material": "^5.16.12 || ^6.0.0 || ^7.0.0",
