{
    "name": "ra-supabase",
    "version": "3.5.2",
    "repository": "git@github.com:marmelab/ra-supabase.git",
    "author": "Gildas Garcia <1122076+djhi@users.noreply.github.com>",
    "license": "MIT",
    "files": [
        "*.md",
        "dist",
        "src"
    ],
    "type": "module",
    "zshy": {
        "exports": "./src/index.ts",
        "noEdit": true
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "sideEffects": false,
    "dependencies": {
        "ra-supabase-core": "^3.5.2",
        "ra-supabase-language-english": "^3.5.0",
        "ra-supabase-ui-materialui": "^3.5.2"
    },
    "devDependencies": {
        "typescript": "^5.7.3",
        "zshy": "^0.5.0"
    },
    "scripts": {
        "build": "zshy --silent",
        "lint": "eslint --fix ./src"
    }
}
